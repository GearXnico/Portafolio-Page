# Image for local development only (compose.yml). The production one is Dockerfile.
FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /code
COPY pyproject.toml ./
COPY app ./app
# Includes the development dependencies so pytest, ruff and mypy can run inside the container.
RUN pip install --no-cache-dir -e ".[dev]"
COPY alembic.ini ./
COPY alembic ./alembic
COPY tests ./tests

EXPOSE 8000
# Migrations are applied by the `migrate` service of compose.yml before the API starts.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
