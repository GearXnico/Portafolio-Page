# Imagen solo para desarrollo local (compose.yml). La de producción es la tarea 1.6.
FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /code
COPY pyproject.toml ./
COPY app ./app
# Incluye las dependencias de desarrollo para poder correr pytest, ruff y mypy dentro del contenedor.
RUN pip install --no-cache-dir -e ".[dev]"
COPY alembic.ini ./
COPY alembic ./alembic
COPY tests ./tests

EXPOSE 8000
# En local, las migraciones se aplican al arrancar (arquitectura, sección de datos).
CMD ["sh", "-c", "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload"]
