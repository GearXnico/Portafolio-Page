# Image for local development only (compose.yml). The production one is Dockerfile (Caddy).
FROM node:24-alpine

# Runs as the unprivileged user that ships with the image, not as root.
WORKDIR /code
RUN chown node:node /code
USER node

COPY --chown=node:node package.json package-lock.json .npmrc ./
RUN npm ci

EXPOSE 5173
CMD ["npm", "run", "dev"]
