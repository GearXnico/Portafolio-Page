# Production web server (ADR, architecture decision record, 0001): automatic HTTPS, the page, /media and /api.
# SITE_ADDRESS is the domain (for example, ejemplo.cl). With http://localhost it serves HTTP only,
# as in the CI (continuous integration) deploy-check job.
{
	# No admin API: the configuration changes only with a new deployment.
	admin off
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# The same values as web/security-headers.ts; the deploy-check E2E (end-to-end) tests compare them.
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		# HTTPS only for one year. Browsers ignore it if it arrives over HTTP.
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	handle /api/* {
		# Cap before reaching the API, which has its own limits. A 5 MB screenshot fits.
		request_body {
			max_size 6MB
		}
		# Caddy replaces X-Forwarded-For with the visitor's real IP, and the API only reads it
		# from the internal network of compose.prod.yml (TRUSTED_PROXIES).
		reverse_proxy api:8000
	}

	# Project screenshots, which the API stores in the shared volume.
	handle_path /media/* {
		root * /srv/media
		file_server
	}

	# The page (SPA, single-page application): paths that aren't files return index.html.
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
