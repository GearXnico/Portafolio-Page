# Servidor web de producción (ADR 0001): HTTPS automático, la página, /media y /api.
# SITE_ADDRESS es el dominio (por ejemplo, ejemplo.cl). Con http://localhost sirve solo HTTP,
# como en el job deploy-check de CI.
{
	# Sin API de administración: la configuración cambia solo con un despliegue nuevo.
	admin off
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# Los mismos valores de web/security-headers.ts; el E2E de deploy-check los compara.
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		# Solo HTTPS durante un año. Los navegadores lo ignoran si llega por HTTP.
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	handle /api/* {
		# Tope antes de llegar a la API, que tiene sus propios límites. Cabe una captura de 5 MB.
		request_body {
			max_size 6MB
		}
		# Caddy reemplaza X-Forwarded-For por la IP real del visitante, y la API solo lo lee
		# desde la red interna de compose.prod.yml (TRUSTED_PROXIES).
		reverse_proxy api:8000
	}

	# Capturas de los proyectos, que guarda la API en el volumen compartido.
	handle_path /media/* {
		root * /srv/media
		file_server
	}

	# La página (SPA): las rutas que no son archivos devuelven index.html.
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
