# Copia este archivo a .env (cp .env.example .env). Nunca subas .env al repo.
# Estos valores son solo para desarrollo local.

COMPOSE_PROJECT_NAME=producto

# Base de datos (Postgres)
POSTGRES_USER=app
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=app

# Para correr la API, Alembic o pytest desde tu máquina (fuera de Docker).
# Dentro de Docker, compose.yml arma esta URL con el host "db".
DATABASE_URL=postgresql+psycopg://app:cambia-esta-clave@localhost:5432/app

# Puertos en tu máquina
DB_PORT=5432
API_PORT=8000
WEB_PORT=5173
