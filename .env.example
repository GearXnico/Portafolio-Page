# Copy this file to .env (cp .env.example .env). Never commit .env to the repo.
# These values are for local development only.

COMPOSE_PROJECT_NAME=producto

# Database (Postgres)
# Table owner: used only by the migrations (Alembic).
POSTGRES_USER=app
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=app
# API user: only reads and writes rows (db/init/01-api-user.sh).
APP_DB_USER=app_api
APP_DB_PASSWORD=cambia-esta-otra-clave

# To run the API, Alembic or pytest from your machine (outside Docker).
# Inside Docker, compose.yml builds this URL with the host "db".
DATABASE_URL=postgresql+psycopg://app_api:cambia-esta-otra-clave@localhost:5432/app
MIGRATION_DATABASE_URL=postgresql+psycopg://app:cambia-esta-clave@localhost:5432/app

# Email notification for each contact message (Gmail SMTP, Simple Mail Transfer Protocol; ADR, architecture decision record, 0005).
# If you leave them empty, the message is still saved and the log says email is disabled.
# SMTP_PASSWORD is a Gmail app password, never your normal password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_NOTIFY_TO=

# IPs or networks of the trusted proxies, comma-separated (in production, the Caddy network).
# X-Forwarded-For is read only from them to learn the visitor's real IP, which the contact
# message rate limit uses. Leave it empty locally.
TRUSTED_PROXIES=

# Single panel administrator (ADR 0004). If any is missing, login responds 503.
# Generate the hash with: docker compose run --rm api python -m app.hash_password
# and paste it as is, in single quotes (the hash has "$" that Compose would interpret).
# JWT_SECRET (JSON Web Token secret) signs the session: generate one with  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
JWT_SECRET=

# Production and staging only (deploy/compose.prod.yml): the domain Caddy serves, for example
# ejemplo.cl, with automatic HTTPS. To try that compose locally, use http://localhost
# (HTTP only; see deploy/README.md). If empty, the production compose doesn't start.
SITE_ADDRESS=

# Production only (deploy/backup.sh, ADR 0010): the age public key (age1...) the daily backup is
# encrypted to, and the private Object Storage bucket it is uploaded to. Keep the private key off the server.
BACKUP_AGE_RECIPIENT=
BACKUP_BUCKET=

# Ports on your machine
DB_PORT=5432
API_PORT=8000
WEB_PORT=5173
