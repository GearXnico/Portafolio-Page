# Copia este archivo a .env (cp .env.example .env). Nunca subas .env al repo.
# Estos valores son solo para desarrollo local.

COMPOSE_PROJECT_NAME=producto

# Base de datos (Postgres)
# Dueño de las tablas: solo lo usan las migraciones (Alembic).
POSTGRES_USER=app
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=app
# Usuario de la API: solo lee y escribe filas (db/init/01-usuario-api.sh).
APP_DB_USER=app_api
APP_DB_PASSWORD=cambia-esta-otra-clave

# Para correr la API, Alembic o pytest desde tu máquina (fuera de Docker).
# Dentro de Docker, compose.yml arma esta URL con el host "db".
DATABASE_URL=postgresql+psycopg://app_api:cambia-esta-otra-clave@localhost:5432/app
MIGRATION_DATABASE_URL=postgresql+psycopg://app:cambia-esta-clave@localhost:5432/app

# Aviso por correo de cada mensaje de contacto (SMTP de Gmail, ADR 0005).
# Si los dejas vacíos, el mensaje igual se guarda y el log avisa que el correo está desactivado.
# SMTP_PASSWORD es una contraseña de aplicación de Gmail, nunca tu clave normal.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_NOTIFY_TO=

# IP o redes de los proxies de confianza, separadas por coma (en producción, la red de Caddy).
# Solo de ellos se lee X-Forwarded-For para saber la IP real del visitante, que usa el límite
# de mensajes de contacto. En local se deja vacío.
TRUSTED_PROXIES=

# Puertos en tu máquina
DB_PORT=5432
API_PORT=8000
WEB_PORT=5173
